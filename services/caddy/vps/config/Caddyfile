##################
# Global options #
##################
{
	dynamic_dns {
		provider cloudflare {$CF_API_TOKEN}
		domains {
			{$DOMAIN} @ * *.home *.kalasz
		}
		versions ipv4 ipv6
		ip_source simple_http https://ipv4.icanhazip.com
		ip_source simple_http https://ipv6.icanhazip.com
	}

	# The admin API is reachable only on Docker networks because it is not
	# published by Compose. Homepage uses it for the Caddy widget.
	admin 0.0.0.0:2019

	crowdsec {
		api_url http://crowdsec:8080
		api_key {$CROWDSEC_BOUNCER_API_KEY}
		ticker_interval 15s
		metrics_interval 1m
	}
}

############
# Snippets #
############
# The public-edge bundle: TLS, compression, CrowdSec remediation, and the access
# log CrowdSec parses. A site that skips this import is neither filtered nor
# detected, so every public site imports it and nothing else carries logging.
(cloudflare) {
	route {
		crowdsec
	}

	tls {
		dns cloudflare {$CF_API_TOKEN}
		resolvers 1.1.1.1 1.0.0.1
	}

	encode zstd gzip

	log {
		output file /var/log/caddy/caddy_access.log

		# Caddy redacts Authorization and Cookie by itself; application
		# credentials that travel in other headers are dropped here so they
		# never reach the log file or the CrowdSec alert context.
		format filter {
			wrap json
			fields {
				request>headers>X-Api-Key delete
				request>headers>X-Api-Secret delete
			}
		}
	}
}

# Tinyauth forward auth, backed by Pocket ID. Tinyauth resolves the protected
# application from the forwarded host, so this snippet stays generic.
(authenticate_tinyauth) {
	forward_auth http://tinyauth:3000 {
		uri /api/auth/caddy

		# Capitalization matters; these arrive empty otherwise.
		copy_headers Remote-User Remote-Name Remote-Email Remote-Groups Authorization
	}
}

# Tailnet clients reach the backend directly; every other client authenticates.
(authenticate_tinyauth_with_tailscale_bypass) {
	@tailscale_network {
		remote_ip 100.64.0.0/10
	}

	# Skip authentication for local network requests
	handle @tailscale_network {
		# Just pass through to the backend without authentication
	}

	# Apply authentication for non-local requests
	handle {
		import authenticate_tinyauth
	}
}

