##################
# Global options #
##################
{
	dynamic_dns {
		provider cloudflare {$CF_API_TOKEN}
		domains {
			{$DOMAIN} @ * *.home *.kalasz
		}
		versions ipv4 ipv6
		ip_source simple_http https://ipv4.icanhazip.com
		ip_source simple_http https://ipv6.icanhazip.com
	}

	# The admin API is reachable only on Docker networks because it is not
	# published by Compose. Homepage uses it for the Caddy widget.
	admin 0.0.0.0:2019
}

############
# Snippets #
############
(cloudflare) {
	tls {
		dns cloudflare {$CF_API_TOKEN}
		resolvers 1.1.1.1 1.0.0.1
	}

	encode zstd gzip
}

(log_common) {
	log {
		output file /var/log/caddy/caddy_access.log
	}
}

(authenticate) {
	route {
		# always forward outpost path to actual outpost
		reverse_proxy /outpost.goauthentik.io/* http://authentik-server:9000

		# Preserve the app URL before forward_auth clones and retargets the request.
		request_header X-Authentik-Original-Host {host}
		request_header X-Authentik-Original-Proto {scheme}

		forward_auth http://authentik-server:9000 {
			uri /outpost.goauthentik.io/auth/caddy

			# Authentik selects the forward-auth provider from the original app URL.
			header_up X-Forwarded-Host {http.request.header.X-Authentik-Original-Host}
			header_up X-Forwarded-Proto {http.request.header.X-Authentik-Original-Proto}

			# capitalization of the headers is important, otherwise they will be empty
			copy_headers X-Authentik-Username X-Authentik-Groups X-Authentik-Entitlements X-Authentik-Email X-Authentik-Name X-Authentik-Uid X-Authentik-Jwt X-Authentik-Meta-Jwks X-Authentik-Meta-Outpost X-Authentik-Meta-Provider X-Authentik-Meta-App X-Authentik-Meta-Version X-Forwarded-Role authorization

			# optional, in this config trust all private ranges, should probably be set to the outposts IP
			trusted_proxies private_ranges
		}

		request_header -X-Authentik-Original-Host
		request_header -X-Authentik-Original-Proto
	}
}

# Local network authentication bypass
(authenticate_with_tailscale_bypass) {
	@tailscale_network {
		remote_ip 100.64.0.0/10
	}

	# Skip authentication for local network requests
	handle @tailscale_network {
		# Just pass through to the backend without authentication
	}

	# Apply authentication for non-local requests
	handle {
		import authenticate
	}
}

# Tinyauth forward auth, backed by Pocket ID. Tinyauth resolves the protected
# application from the forwarded host, so this snippet stays generic.
(authenticate_tinyauth) {
	forward_auth http://tinyauth:3000 {
		uri /api/auth/caddy

		# Capitalization matters; these arrive empty otherwise.
		copy_headers Remote-User Remote-Name Remote-Email Remote-Groups
	}
}

# Tinyauth equivalent of authenticate_with_tailscale_bypass. Kept separate so
# the Authentik wrapper and its applications stay untouched.
(authenticate_tinyauth_with_tailscale_bypass) {
	@tailscale_network {
		remote_ip 100.64.0.0/10
	}

	# Skip authentication for local network requests
	handle @tailscale_network {
		# Just pass through to the backend without authentication
	}

	# Apply authentication for non-local requests
	handle {
		import authenticate_tinyauth
	}
}

##########################
# VPS Hosted Services    #
##########################

komodo.{$DOMAIN} {
	import cloudflare
	import log_common
	# Komodo Core runs on this host. The former docker-host upstream stayed
	# behind as a failover after the move, but nothing listens there any more,
	# so its active health check only produced a failure every ten seconds.
	reverse_proxy komodo-core:9120
}

beszel.{$DOMAIN} {
	import cloudflare
	import log_common
	reverse_proxy beszel:8090
}

uptime.{$DOMAIN} {
	import cloudflare
	import log_common
	import authenticate_with_tailscale_bypass
	reverse_proxy uptime-kuma:3001
}

ntfy.{$DOMAIN} {
	import cloudflare
	import log_common
	reverse_proxy ntfy:80
}

auth.{$DOMAIN} {
	import cloudflare

	# The site Caddy passes the protected application's URL in X-Forwarded-*.
	# Preserve it for every outpost request before reverse_proxy replaces those
	# headers with this proxy hop, including the post-login callback.
	route /outpost.goauthentik.io/* {
		request_header X-Authentik-Original-Forwarded-Host {http.request.header.X-Forwarded-Host}
		request_header X-Authentik-Original-Forwarded-Proto {http.request.header.X-Forwarded-Proto}

		reverse_proxy authentik-server:9000 {
			header_up X-Forwarded-Host {http.request.header.X-Authentik-Original-Forwarded-Host}
			header_up X-Forwarded-Proto {http.request.header.X-Authentik-Original-Forwarded-Proto}
			header_up -X-Authentik-Original-Forwarded-Host
			header_up -X-Authentik-Original-Forwarded-Proto
		}
	}

	# Keep the normal Authentik UI and callback traffic unchanged.
	reverse_proxy authentik-server:9000
}

# Pocket ID is an identity provider, so it authenticates its own requests and
# must never sit behind a forward-auth snippet.
id.{$DOMAIN} {
	import cloudflare
	import log_common
	reverse_proxy pocket-id:1411
}

# Tinyauth serves the login flow itself, so it must not sit behind forward auth.
login.{$DOMAIN} {
	import cloudflare
	import log_common
	reverse_proxy tinyauth:3000
}

dash.{$DOMAIN} {
	import authenticate_tinyauth_with_tailscale_bypass
	import cloudflare
	reverse_proxy homepage:3000
}

actual.{$DOMAIN} {
	import cloudflare
	reverse_proxy docker.{$TAILNET}:{$PORT_ACTUAL_HTTP}
}

