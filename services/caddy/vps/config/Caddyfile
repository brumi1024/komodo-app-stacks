komodo.{$DOMAIN} {
	import cloudflare
	reverse_proxy komodo-core:9120
}

beszel.{$DOMAIN} {
	import cloudflare
	reverse_proxy beszel:8090
}

uptime.{$DOMAIN} {
	import cloudflare
	import authenticate_tinyauth_with_tailscale_bypass
	reverse_proxy uptime-kuma:3001
}

ntfy.{$DOMAIN} {
	import cloudflare
	reverse_proxy ntfy:80
}

# Pocket ID is an identity provider, so it authenticates its own requests and
# must never sit behind a forward-auth snippet.
id.{$DOMAIN} {
	import cloudflare
	reverse_proxy pocket-id:1411
}

# Tinyauth serves the login flow itself, so it must not sit behind forward auth.
login.{$DOMAIN} {
	import cloudflare

	# Site Caddy instances forward-auth here and pass the protected
	# application's URL in X-Forwarded-*. Preserve it across this proxy hop,
	# which would otherwise replace those headers with this login host and make
	# Tinyauth resolve the wrong application.
	route /api/auth/* {
		request_header X-Tinyauth-Original-Forwarded-Host {http.request.header.X-Forwarded-Host}
		request_header X-Tinyauth-Original-Forwarded-Proto {http.request.header.X-Forwarded-Proto}

		reverse_proxy tinyauth:3000 {
			header_up X-Forwarded-Host {http.request.header.X-Tinyauth-Original-Forwarded-Host}
			header_up X-Forwarded-Proto {http.request.header.X-Tinyauth-Original-Forwarded-Proto}
			header_up -X-Tinyauth-Original-Forwarded-Host
			header_up -X-Tinyauth-Original-Forwarded-Proto
		}
	}

	reverse_proxy tinyauth:3000
}

dash.{$DOMAIN} {
	import authenticate_tinyauth_with_tailscale_bypass
	import cloudflare
	reverse_proxy homepage:3000
}

actual.{$DOMAIN} {
	import cloudflare
	reverse_proxy docker.{$TAILNET}:{$PORT_ACTUAL_HTTP}
}

# Canonical forge name. Deployment-wide rather than site-local, so git remotes
# survive the forge moving hosts. git.home.{$DOMAIN} reaches the same service
# through the home edge and becomes the direct path once split DNS lands.
git.{$DOMAIN} {
	import cloudflare
	reverse_proxy docker.{$TAILNET}:{$PORT_FORGEJO_HTTP}
}

