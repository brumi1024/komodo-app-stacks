#############################################
# Site fallback edges                       #
# Public DNS decides when traffic uses VPS. #
#############################################

*.home.{$DOMAIN} {
	import cloudflare
	reverse_proxy https://docker.{$TAILNET}:443 {
		# Caddy 2.11 normally aligns Host with the upstream hostname.
		# Preserve the public host so the site Caddy selects the right route.
		header_up Host {host}
		transport http {
			# Use one stable certificate identity for the site edge so the
			# transport can reuse connections across fallback hostnames.
			tls_server_name homeassistant.home.{$DOMAIN}
		}
	}
}

*.seq.{$DOMAIN} {
	import cloudflare
	reverse_proxy https://docker-seq.{$TAILNET}:443 {
		header_up Host {host}
		transport http {
			tls_server_name homeassistant.seq.{$DOMAIN}
		}
	}
}
