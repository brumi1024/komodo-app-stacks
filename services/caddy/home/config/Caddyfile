# Services
# No forward auth here: Forgejo owns its own login through Pocket ID, and
# git over HTTP would break behind an interactive auth redirect.
git.home.{$DOMAIN} {
	import cloudflare
	reverse_proxy docker.{$TAILNET}:{$PORT_FORGEJO_HTTP}
}

paperless.home.{$DOMAIN} {
	import cloudflare
	reverse_proxy docker.{$TAILNET}:{$PORT_PAPERLESS_HTTP}
}

stirling.home.{$DOMAIN} {
	import cloudflare
	reverse_proxy docker.{$TAILNET}:{$PORT_STIRLING_HTTP}
}

immich.home.{$DOMAIN} {
	import cloudflare
	reverse_proxy docker.{$TAILNET}:{$PORT_IMMICH_HTTP}
}

evcc.home.{$DOMAIN} {
	import cloudflare

	@provider_auth path /providerauth/*
	handle @provider_auth {
		reverse_proxy docker.{$TAILNET}:{$PORT_EVCC_HTTP}
	}

	import authenticate_tinyauth_with_tailscale_bypass

	handle {
		reverse_proxy docker.{$TAILNET}:{$PORT_EVCC_HTTP}
	}
}
