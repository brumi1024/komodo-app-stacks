##################
# Global options #
##################
{
	dynamic_dns {
		provider cloudflare {$CF_API_TOKEN}
		domains {
			{$DOMAIN} seq seq-origin-v6 *.seq
		}
		versions ipv6
		ip_source simple_http https://ipv6.icanhazip.com
		ip_source simple_http https://api6.ipify.org
	}

	admin 0.0.0.0:{$PORT_CADDY_ADMIN}

	# The VPS is a trusted fallback proxy over Tailscale.
	# Strict client-IP parsing preserves public client identity and prevents
	# fallback traffic from inheriting the Tailnet authentication bypass.
	servers {
		trusted_proxies static 100.64.0.0/10
		trusted_proxies_strict
	}
}

############
# Snippets #
############
(cloudflare) {
	tls {
		dns cloudflare {$CF_API_TOKEN}
		resolvers 1.1.1.1 1.0.0.1
	}

	encode zstd gzip
}

(log_common) {
	log {
		output file /var/log/caddy/caddy_access.log
	}
}

##########################
# Sequoia Site Services  #
##########################

# Home Assistant
homeassistant.seq.{$DOMAIN} {
	import cloudflare
	reverse_proxy http://homeassistant-seq.{$TAILNET}:{$PORT_HOMEASSISTANT_HTTP}
}

# Synology NAS
zephyrus.seq.{$DOMAIN} {
	import cloudflare
	reverse_proxy http://zephyrus.{$TAILNET}:{$PORT_ZEPHYRUS_HTTP}
}

scrypted.seq.{$DOMAIN} {
	import cloudflare
	reverse_proxy https://scrypted-sequoia.{$TAILNET}:{$PORT_SCRYPTED_HTTPS} {
		transport http {
			tls
			tls_insecure_skip_verify
		}
	}
}
