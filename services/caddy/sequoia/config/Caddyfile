##################
# Global options #
##################
{
	dynamic_dns {
		provider cloudflare {$CF_API_TOKEN}
		domains {
			{$DOMAIN} seq seq-origin-v6 *.seq
		}
		versions ipv6
		ip_source simple_http https://ipv6.icanhazip.com
		ip_source simple_http https://api6.ipify.org
	}

	admin 0.0.0.0:{$PORT_CADDY_ADMIN}

	# The VPS is a trusted fallback proxy over Tailscale.
	# Strict client-IP parsing preserves public client identity and prevents
	# fallback traffic from inheriting the Tailnet authentication bypass.
	servers {
		trusted_proxies static 100.64.0.0/10
		trusted_proxies_strict
	}
}

############
# Snippets #
############
(cloudflare) {
	tls {
		dns cloudflare {$CF_API_TOKEN}
		resolvers 1.1.1.1 1.0.0.1
	}

	encode zstd gzip
}

(log_common) {
	log {
		output file /var/log/caddy/caddy_access.log
	}
}

# Tinyauth forward auth, backed by Pocket ID. Tinyauth resolves the protected
# application from the forwarded host, so this snippet stays generic.
(authenticate_tinyauth) {
	forward_auth https://login.{$DOMAIN} {
		uri /api/auth/caddy

		# Capitalization matters; these arrive empty otherwise.
		copy_headers Remote-User Remote-Name Remote-Email Remote-Groups Authorization
	}
}

# Tailnet clients reach the backend directly; every other client authenticates.
(authenticate_tinyauth_with_tailscale_bypass) {
	@tailscale_network {
		client_ip 100.64.0.0/10
	}

	# Skip authentication for local network requests
	handle @tailscale_network {
		# Just pass through to the backend without authentication
	}

	# Apply authentication for non-local requests
	handle {
		import authenticate_tinyauth
	}
}

##########################
# Sequoia Site Services  #
##########################

# Home Assistant
homeassistant.seq.{$DOMAIN} {
	import cloudflare
	reverse_proxy http://homeassistant-seq.{$TAILNET}:{$PORT_HOMEASSISTANT_HTTP}
}

# Synology NAS
zephyrus.seq.{$DOMAIN} {
	import cloudflare
	reverse_proxy http://zephyrus.{$TAILNET}:{$PORT_ZEPHYRUS_HTTP}
}

scrypted.seq.{$DOMAIN} {
	import cloudflare
	reverse_proxy https://scrypted-sequoia.{$TAILNET}:{$PORT_SCRYPTED_HTTPS} {
		transport http {
			tls
			tls_insecure_skip_verify
		}
	}
}

# Zigbee2MQTT
z2m.seq.{$DOMAIN} {
	import authenticate_tinyauth_with_tailscale_bypass
	import cloudflare
	reverse_proxy sequoia-rpi-4.{$TAILNET}:{$PORT_ZIGBEE2MQTT}
}
