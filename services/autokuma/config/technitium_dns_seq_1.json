{
  "type": "dns",
  "name": "Technitium DNS Sequoia 1",
  "hostname": "example.com",
  "dns_resolve_server": "technitiumdns-seq-1.{{ get_env(name='AUTOKUMA__ENV__TAILNET') }}",
  "port": 53,
  "dns_resolve_type": "A",
  "interval": 60,
  "max_retries": 2,
  "tag_names": [{"name": "site", "value": "sequoia"}, {"name": "host", "value": "technitiumdns-seq-1"}]
}
