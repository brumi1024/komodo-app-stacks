{
  "type": "notification",
  "active": true,
  "isDefault": false,
  "name": "Ntfy",
  "config": {
    "type": "ntfy",
    "applyExisting": false,
    "ntfyserverurl": "https://ntfy.{{ get_env(name='AUTOKUMA__ENV__NTFY_DOMAIN') | json_escape }}",
    "ntfytopic": "homelab-alerts",
    "ntfyAuthenticationMethod": "accessToken",
    "ntfyaccesstoken": "{{ get_env(name='AUTOKUMA__ENV__NTFY_ACCESS_TOKEN') | json_escape }}",
    "ntfyPriority": 4
  }
}
